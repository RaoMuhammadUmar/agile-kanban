# Supabase Postgres connection string.
# Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# (use the "Connection pooling" URI, port 6543, for serverless-friendly pooling,
# or the direct connection on port 5432 for a long-lived Node server like this one)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Any long, random string. Used to sign/verify JWTs. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

# Port the Express server listens on
PORT=5000

# The origin your Vite dev server (or deployed frontend) runs on, for CORS
CLIENT_ORIGIN=http://localhost:5173
